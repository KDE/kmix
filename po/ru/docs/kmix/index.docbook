<abstract>
<para
>&kmix; — это программа для управления громкостью звука.</para>
</abstract>

<keywordset>
<keyword
>KDE</keyword>
<keyword
>KMix</keyword>
<keyword
>kdemultimedia</keyword>
<keyword
>звук</keyword>
<keyword
>громкость</keyword>
<keyword
>микшер</keyword>

</keywordset>

</bookinfo>
